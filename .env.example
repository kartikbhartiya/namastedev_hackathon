# Orbit Study OS - Environment Variables
# Copy this file to .env.local or .env to configure your local setup.

# 1. Groq API Key (PRIMARY AI INFERENCE)
# Required for Llama 3.3 70B Socratic Tutor, AI Mock Interviewer, and Quizzes.
# Get your free key at: https://console.groq.com/keys
NEXT_PUBLIC_GROQ_API_KEY=your_groq_api_key_here

# 2. Supabase Configuration (AUTH & DATABASE)
# Required for user profiles, study sessions, XP, and interview scorecards.
# Get your URL and anon key at: https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# 3. OpenAI API Key (OPTIONAL / FALLBACK)
# Optional fallback key for advanced multi-modal models.
NEXT_PUBLIC_OPENAI_API_KEY=your_openai_api_key_here
